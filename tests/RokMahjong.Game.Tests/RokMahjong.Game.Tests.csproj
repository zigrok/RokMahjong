<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <FormaRuntime>MonoGame</FormaRuntime>
    <MonoGameProjectPath>$(MSBuildThisFileDirectory)../../third_party/MonoGame/MonoGame.Framework/MonoGame.Framework.DesktopGL.csproj</MonoGameProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RokMahjong.Core/RokMahjong.Core.csproj" />
    <ProjectReference Include="../../src/RokMahjong.Game/RokMahjong.Game.csproj" />
    <ProjectReference Include="../../third_party/Forma/src/Forma/Forma.csproj"
                      AdditionalProperties="FormaRuntime=MonoGame;MonoGameProjectPath=$(MonoGameProjectPath)" />
    <ProjectReference Include="../../third_party/Forma/src/Forma.DynamicText/Forma.DynamicText.csproj"
                      AdditionalProperties="FormaRuntime=MonoGame;MonoGameProjectPath=$(MonoGameProjectPath)" />
    <ProjectReference Include="../../third_party/Forma/src/Forma.Testing/Forma.Testing.csproj"
                      AdditionalProperties="FormaRuntime=MonoGame;MonoGameProjectPath=$(MonoGameProjectPath)" />
  </ItemGroup>

</Project>
